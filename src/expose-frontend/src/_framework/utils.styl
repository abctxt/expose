//
// Various Stylus mixins
//
no-interaction(disablePointer = true)
  user-select none
  -webkit-user-drag none
  if disablePointer
    pointer-events none


ui5(suffix, value)
  --_ui5_{suffix} value

ui5Button(suffix, value)
  --sapButton_{suffix} value

ui5Content(suffix, value)
  --sapContent_{suffix} value
