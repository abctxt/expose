<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Expose</AssemblyName>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expose.Core\Expose.Core.fsproj" />
    <ProjectReference Include="..\Expose.Data\Expose.Data.csproj" />
    <ProjectReference Include="..\Expose.Functions\Expose.Functions.fsproj" />
    <ProjectReference Include="..\Expose.Lang\Expose.Lang.fsproj" />
    <ProjectReference Include="..\ExposeWeb.Schema\ExposeWeb.Schema.csproj" />
    <ProjectReference Include="..\ExposeWeb.Workflows\ExposeWeb.Workflows.csproj" />
    <ProjectReference Include="..\ExposeWeb.Generator\ExposeWeb.Generator.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.6" />
    <PackageReference Include="protobuf-net.Grpc.AspNetCore" Version="1.3.14" />
    <PackageReference Include="Temporalio" Version="1.22.0" />
    <PackageReference Include="Temporalio.Extensions.Hosting" Version="1.22.0" />
    <PackageReference Include="Quartz" Version="4.7.3" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="4.7.3" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="11.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Tomlyn" Version="2.11.1" />
    <PackageReference Include="Tomlyn.Extensions.Configuration" Version="2.0.1" />
  </ItemGroup>

</Project>
