<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Expose.Core</AssemblyName>
    <RootNamespace>Expose.Core</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expose.Lang\Expose.Lang.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="CommonTypes.fs" />
    <Compile Include="Securities.fs" />
    <Compile Include="Portfolio.fs" />
    <Compile Include="Watchlist.fs" />
    <Compile Include="NewsFlow.fs" />
    <Compile Include="Notifications.fs" />
    <Compile Include="EtfHoldings.fs" />
    <Compile Include="Automations.fs" />
    <Compile Include="Integrations.fs" />
    <Compile Include="AiChat.fs" />
    <Compile Include="Search.fs" />
  </ItemGroup>

</Project>
