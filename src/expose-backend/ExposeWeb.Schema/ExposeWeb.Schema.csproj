<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RootNamespace>Expose.Schema</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expose.Data\Expose.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microting.EntityFrameworkCore.MySql" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Definitions\" />
    <Folder Include="Migrations\" />
  </ItemGroup>

</Project>
