<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Expose.Functions</AssemblyName>
    <RootNamespace>Expose.Functions</RootNamespace>
    <TargetFramework>net11.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Expose.Data\Expose.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageReference Update="FSharp.Core" Version="11.0.101" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Common\Attributes.fs" />
    <Compile Include="Common\ErrorCodes.fs" />
    <Compile Include="Common\ServiceInterfaces.fs" />
    <Compile Include="Common\SecurityInterfaces.fs" />
    <Compile Include="Securities.fs" />
    <Compile Include="EtfHoldings.fs" />
    <Compile Include="Portfolio.fs" />
    <Compile Include="Watchlist.fs" />
    <Compile Include="AiChat.fs" />
    <Compile Include="Search.fs" />
  </ItemGroup>

</Project>
