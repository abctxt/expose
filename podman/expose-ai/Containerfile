FROM node:24-alpine AS build

WORKDIR /build

RUN apk add --no-cache python3 make g++

COPY src/expose-ai/package.json src/expose-ai/package-lock.json ./
RUN npm ci

COPY src/expose-ai/ ./
RUN npm run build && npm prune --omit=dev

FROM node:24-alpine

ARG user=expose
ARG home=/expose

ENV NODE_ENV=production

RUN addgroup -S ${user} && adduser -S -G ${user} -h ${home} ${user} && \
    mkdir -p ${home}

COPY --from=build /build/package.json ${home}/package.json
COPY --from=build /build/node_modules ${home}/node_modules
COPY --from=build /build/dist ${home}/dist

RUN chown -R ${user}:${user} ${home}

EXPOSE 3000/tcp

USER ${user}
WORKDIR ${home}

CMD ["node", "dist/main.js"]
